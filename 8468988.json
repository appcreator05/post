<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMDb</title>
    <!-- Tailwind CSS CDN for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Custom Scrollbar for movie slider */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-gray-900 text-white font-sans min-h-screen">

    <!-- Header / Navbar -->
    <header class="flex justify-between items-center p-4 md:px-8 bg-gray-800 border-b border-gray-700 sticky top-0 z-50">
        <div class="text-2xl font-bold text-red-600 flex items-center gap-2">
            <i class="fa-solid fa-film"></i> MovieApp
        </div>
        <div class="relative w-1/3 max-w-xs hidden sm:block">
            <input type="text" placeholder="Search movies..." class="w-full bg-gray-700 text-sm text-white rounded-full pl-10 pr-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-600">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400"></i>
        </div>
    </header>

    <!-- Hero Banner Section -->
    <section class="relative h-64 md:h-96 flex items-end p-6 md:p-12 bg-cover bg-center" style="background-image: linear-gradient(to top, rgba(17,24,39,1), rgba(17,24,39,0.3)), url('https://picsum.photos/1200/500?random=100');">
        <div>
            <span class="bg-red-600 text-xs px-2 py-1 rounded font-bold uppercase tracking-wide">Featured</span>
            <h1 class="text-3xl md:text-5xl font-extrabold mt-2 mb-2">Featured Blockbuster Movie</h1>
            <p class="text-gray-300 text-sm md:text-base max-w-xl mb-4">Watch the latest trending movies and web series anytime, anywhere.</p>
            <button class="bg-white text-black font-bold px-5 py-2.5 rounded-lg flex items-center gap-2 hover:bg-gray-200 transition">
                <i class="fa-solid fa-play"></i> Watch Trailer
            </button>
        </div>
    </section>

    <!-- Movie Categories Container -->
    <main class="p-4 md:p-8 space-y-8" id="movie-container">
        <!-- Movies will be dynamically loaded here by JavaScript -->
    </main>

    <!-- Footer -->
    <footer class="text-center py-6 border-t border-gray-800 text-gray-500 text-sm">
        &copy; 2026 MovieApp All Rights Reserved.
    </footer>

    <!-- JavaScript to Render Categories and Movie Cards -->
    <script>
        // JSON data without video fields
        const rawMovieData = [
            {
                "id": "kajolstorege20",
                "title": "Dead Sea 2024",
                "category": "Hollywood Hindi Dubbed",
                "poster": "https://raw.githubusercontent.com/appcreator05/768/main/5/1786351607432.jpg",
                "rating": "6.3",
                "cast": "Isabel Gravitt, Alexander Wraith, Dean Cameron, Garrett Wareing, Genneya Walton, Koa Tom, Brian Silverman, Al Burke,"
            },
            {
                "id": "kajolstorege20",
                "title": "The Map That Leads to You 2025",
                "category": "Hollywood Hindi Dubbed",
                "poster": "https://raw.githubusercontent.com/appcreator05/768/main/5/1786351692784.jpg",
                "rating": "6.6",
                "cast": "Madelyn Cline, KJ Apa, Sofia Wylie, Madison Thompson, Orlando Norman, Josh Lucas, JR Esposito, Marilyn Cutts,"
            },
            {
                "id": "myskdstore28",
                "title": "Night at the Museum 2006",
                "category": "Hollywood Hindi Dubbed",
                "poster": "https://raw.githubusercontent.com/appcreator05/768/main/5/1786351812207.jpg",
                "rating": "6.6",
                "cast": "Ben Stiller, Carla Gugino, Dick Van Dyke, Mickey Rooney, Bill Cobbs, Jake Cherry, Ricky Gervais, Robin Williams,"
            },
            {
                "id": "kajolstorege20",
                "title": "Send Help 2026",
                "category": "Hollywood Hindi Dubbed",
                "poster": "https://raw.githubusercontent.com/appcreator05/768/main/5/1786385198744.jpg",
                "rating": "7.0",
                "cast": "Rachel McAdams, Dylan O'Brien, Edyll Ismail, Xavier Samuel, Dennis Haysbert, Chris Pang, Thaneth Warakulnukroh,"
            },
            {
                "id": "kajolstorege20",
                "title": "Anora 2024",
                "category": "Hollywood Hindi Dubbed",
                "poster": "https://raw.githubusercontent.com/appcreator05/768/main/5/1786406052744.jpg",
                "rating": "7.1",
                "cast": "Mikey Madison, Mark Eydelshteyn, Yura Borisov, Karren Karagulian, Vache Tovmasyan, Luna Sofía Miranda,"
            },
            {
                "id": "kajolstorege20",
                "title": "The Bluff 2026",
                "category": "Hollywood Hindi Dubbed",
                "poster": "https://raw.githubusercontent.com/appcreator05/768/main/5/1786406190143.jpg",
                "rating": "6.7",
                "cast": "Priyanka Chopra Jonas, Karl Urban, Safia Oakley-Green, Ismael Cruz Cordova, Temuera Morrison, Vedanten Naidoo,"
            },
            {
                "id": "kajolstorege20",
                "title": "Cicada! 2018",
                "category": "Hollywood Hindi Dubbed",
                "poster": "https://raw.githubusercontent.com/appcreator05/768/main/5/1786406349678.jpg",
                "rating": "2.0",
                "cast": "Jeffrey Ryan Kent, Cassandra Hein, Jose Rosete, Shannon Torrence, Beau Crawford, Lawrence Mandley, Susan Montenegro,"
            }
        ];

        // Group movies by category dynamically
        const groupedData = rawMovieData.reduce((acc, movie) => {
            const cat = movie.category || "General";
            if (!acc[cat]) {
                acc[cat] = [];
            }
            acc[cat].push(movie);
            return acc;
        }, {});

        // Function to render categories and movies
        const container = document.getElementById('movie-container');

        Object.keys(groupedData).forEach(categoryName => {
            const movies = groupedData[categoryName];
            const categoryHTML = `
                <section>
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xl md:text-2xl font-bold border-l-4 border-red-600 pl-3">${categoryName}</h2>
                        <a href="#" class="text-red-500 hover:text-red-400 text-sm font-semibold">View All</a>
                    </div>
                    
                    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-4">
                        ${movies.map(movie => `
                            <div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg group hover:scale-105 transition-transform duration-300 cursor-pointer">
                                <div class="relative">
                                    <img src="${movie.poster}" alt="${movie.title}" class="w-full h-64 object-cover">
                                    <span class="absolute top-2 right-2 bg-black/70 text-yellow-400 text-xs px-2 py-1 rounded font-bold flex items-center gap-1">
                                        <i class="fa-solid fa-star"></i> ${movie.rating}
                                    </span>
                                </div>
                                <div class="p-3">
                                    <h3 class="font-bold text-md truncate group-hover:text-red-500 transition" title="${movie.title}">${movie.title}</h3>
                                    <p class="text-xs text-gray-400 mt-1 truncate" title="${movie.cast}">Cast: ${movie.cast}</p>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </section>
            `;
            container.innerHTML += categoryHTML;
        });
    </script>
</body>
</html>
